{
  "name": "__APP_SLUG__",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "lint": "pnpm --filter api lint && pnpm --filter web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/*.test.mjs && pnpm --filter api test && pnpm --filter web test",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "docker:up": "node scripts/docker.mjs up",
    "docker:down": "node scripts/docker.mjs down",
    "docker:ps": "node scripts/docker.mjs ps",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "eslint-config-prettier": "^10.1.8"
  },
  "engines": {
    "node": ">=24.12 <25",
    "pnpm": ">=10.25 <11"
  },
  "author": __APP_AUTHOR_JSON__,
  "description": __APP_DESCRIPTION_JSON__
}
