{
  "name": "secure-app-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "create:app": "node create-app.mjs",
    "test": "node --test tests/*.test.mjs",
    "format:check": "prettier --check create-app.mjs tests package.json README.md",
    "format": "prettier --write create-app.mjs tests package.json README.md"
  },
  "dependencies": {
    "prettier": "3.10.1"
  }
}
